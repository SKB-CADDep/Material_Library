{
  "name": "material-library",
  "private": true,
  "type": "module",
  "scripts": {
    "test:unit": "npm run test --prefix frontend",
    "test:api": ".venv\\Scripts\\python.exe -m pytest tests/ -q",
    "test:regression": "npm run test:unit && npm run test:api && npm run test:e2e",
    "build:web": "npm run build:web --prefix frontend",
    "prepare:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-portable-python.ps1",
    "package:customer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-customer-distribution.ps1",
    "pretest:e2e": "npm run build:web",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^24.13.2",
    "typescript": "~6.0.2"
  }
}
